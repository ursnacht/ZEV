<jasperReport name="statistik" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="33333333-3333-3333-3333-333333333333">

    <!-- Parameters -->
    <parameter name="STATISTIK" class="ch.nacht.dto.StatistikDTO"/>
    <parameter name="TRANSLATIONS" class="java.util.Map"/>
    <parameter name="SPRACHE" class="java.lang.String"/>
    <parameter name="ZEITRAUM" class="java.lang.String"/>
    <parameter name="GENERIERT_AM" class="java.lang.String"/>
    <parameter name="ORG_NAME" class="java.lang.String"/>
    <parameter name="IST_BILANZ" class="java.lang.Boolean"/>
    <parameter name="EINHEIT_SUMMEN_SUBREPORT" class="net.sf.jasperreports.engine.JasperReport"/>

    <!-- Fields for MonatsStatistik detail band -->
    <field name="jahr" class="java.lang.Integer"/>
    <field name="monat" class="java.lang.Integer"/>
    <field name="von" class="java.time.LocalDate"/>
    <field name="bis" class="java.time.LocalDate"/>
    <field name="datenVollstaendig" class="java.lang.Boolean"/>
    <field name="summeProducerTotal" class="java.lang.Double"/>
    <field name="summeConsumerTotal" class="java.lang.Double"/>
    <field name="summeProducerZev" class="java.lang.Double"/>
    <field name="summeConsumerZev" class="java.lang.Double"/>
    <field name="summeConsumerZevCalculated" class="java.lang.Double"/>
    <field name="bezugVonVnb" class="java.lang.Double"/>
    <field name="ruecklieferung" class="java.lang.Double"/>
    <field name="summenCDGleich" class="java.lang.Boolean"/>
    <field name="differenzCD" class="java.lang.Double"/>
    <field name="summenCEGleich" class="java.lang.Boolean"/>
    <field name="differenzCE" class="java.lang.Double"/>
    <field name="summenDEGleich" class="java.lang.Boolean"/>
    <field name="differenzDE" class="java.lang.Double"/>
    <field name="bezugBilanzGleich" class="java.lang.Boolean"/>
    <field name="bezugBilanzDifferenz" class="java.lang.Double"/>
    <field name="ruecklieferungBilanzGleich" class="java.lang.Boolean"/>
    <field name="ruecklieferungBilanzDifferenz" class="java.lang.Double"/>
    <field name="bilanzBezug" class="java.lang.Double"/>
    <field name="bilanzRuecklieferung" class="java.lang.Double"/>
    <field name="bilanzBezugName" class="java.lang.String"/>
    <field name="bilanzRuecklieferungName" class="java.lang.String"/>
    <field name="einheitSummen" class="java.util.List"/>
    <!-- Statistik-Kennzahlen -->
    <field name="autarkiegrad" class="java.lang.Double"/>
    <field name="eigenverbrauchsquote" class="java.lang.Double"/>
    <field name="netzbezugsquote" class="java.lang.Double"/>
    <field name="autarkiegradGemessen" class="java.lang.Double"/>
    <field name="netzbezugsquoteGemessen" class="java.lang.Double"/>
    <field name="bilanzKennzahlenVerfuegbar" class="java.lang.Boolean"/>
    <field name="bilanzBezugLueckenhaft" class="java.lang.Boolean"/>
    <field name="verteilungLueckenhaft" class="java.lang.Boolean"/>
    <field name="einspeisequote" class="java.lang.Double"/>
    <field name="zevEigenverbrauch" class="java.lang.Double"/>
    <field name="batterieNetto" class="java.lang.Double"/>
    <field name="batterieGeladen" class="java.lang.Double"/>
    <field name="batterieEntladen" class="java.lang.Double"/>
    <field name="batterieWirkungsgrad" class="java.lang.Double"/>
    <field name="batterieKennzahlenVerfuegbar" class="java.lang.Boolean"/>

    <!-- Variable: Maximum of all sums for bar scaling -->
    <variable name="maxSumme" calculation="Nothing" resetType="None" class="java.lang.Double">
        <expression><![CDATA[Math.max(0.0, Math.max(Math.max(Math.max(Math.max(Math.max(Math.max(
            ($F{summeProducerTotal} != null ? $F{summeProducerTotal} : 0.0),
            ($F{summeConsumerTotal} != null ? $F{summeConsumerTotal} : 0.0)),
            ($F{summeProducerZev} != null ? $F{summeProducerZev} : 0.0)),
            ($F{summeConsumerZev} != null ? $F{summeConsumerZev} : 0.0)),
            ($F{summeConsumerZevCalculated} != null ? $F{summeConsumerZevCalculated} : 0.0)),
            ($F{bilanzBezug} != null ? $F{bilanzBezug} : 0.0)),
            ($F{bilanzRuecklieferung} != null ? $F{bilanzRuecklieferung} : 0.0)))]]></expression>
    </variable>

    <!-- Title Band - Report Header -->
    <title height="130">
        <!-- Title: Statistik Report + Anzeigename der Organisation -->
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333301" x="0" y="0" width="555" height="30" forecolor="#4CAF50" fontSize="18.0" bold="true">
            <expression><![CDATA[$P{TRANSLATIONS}.get("STATISTIK_REPORT")
                + ($P{ORG_NAME} != null && !$P{ORG_NAME}.isBlank() ? " – " + $P{ORG_NAME} : "")]]></expression>
        </element>

        <!-- Subtitle: Zeitraum -->
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333302" x="0" y="30" width="80" height="15" forecolor="#666666" fontSize="10.0">
            <expression><![CDATA[$P{TRANSLATIONS}.get("ZEITRAUM") + ":"]]></expression>
        </element>
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333303" x="80" y="30" width="475" height="15" forecolor="#666666" blankWhenNull="true" fontSize="10.0">
            <expression><![CDATA[$P{ZEITRAUM}]]></expression>
        </element>

        <!-- Übersicht section -->
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333304" x="0" y="55" width="555" height="20" forecolor="#333333" fontSize="14.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA[$P{TRANSLATIONS}.get("STATISTIK_UEBERSICHT")]]></expression>
            <box>
                <bottomPen lineWidth="2.0" lineColor="#4CAF50"/>
            </box>
        </element>

        <!-- Messwerte vorhanden bis -->
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333305" x="0" y="80" width="180" height="15" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{TRANSLATIONS}.get("MESSWERTE_VORHANDEN_BIS") + ":"]]></expression>
        </element>
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333306" x="180" y="80" width="375" height="15" blankWhenNull="true" fontSize="10.0">
            <expression><![CDATA[$P{STATISTIK}.getMesswerteBisDate() != null ? $P{STATISTIK}.getMesswerteBisDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "-"]]></expression>
        </element>

        <!-- Datenstatus -->
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333307" x="0" y="95" width="180" height="15" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{TRANSLATIONS}.get("DATENSTATUS") + ":"]]></expression>
        </element>
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333308" x="180" y="95" width="375" height="15" forecolor="#4CAF50" fontSize="10.0">
            <expression><![CDATA[$P{TRANSLATIONS}.get("DATEN_VOLLSTAENDIG")]]></expression>
            <printWhenExpression><![CDATA[$P{STATISTIK}.isDatenVollstaendig()]]></printWhenExpression>
        </element>
        <element kind="textField" uuid="33333333-3333-3333-3333-333333333309" x="180" y="95" width="375" height="15" forecolor="#F44336" fontSize="10.0">
            <expression><![CDATA[$P{TRANSLATIONS}.get("DATEN_UNVOLLSTAENDIG")]]></expression>
            <printWhenExpression><![CDATA[!$P{STATISTIK}.isDatenVollstaendig()]]></printWhenExpression>
        </element>

        <!-- Fehlende Einheiten -->
        <element kind="textField" uuid="33333333-3333-3333-3333-33333333330a" x="0" y="110" width="180" height="15" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{TRANSLATIONS}.get("FEHLENDE_EINHEITEN") + ":"]]></expression>
            <printWhenExpression><![CDATA[!$P{STATISTIK}.getFehlendeEinheiten().isEmpty()]]></printWhenExpression>
        </element>
        <element kind="textField" uuid="33333333-3333-3333-3333-33333333330b" x="180" y="110" width="375" height="15" blankWhenNull="true" fontSize="10.0">
            <expression><![CDATA[String.join(", ", $P{STATISTIK}.getFehlendeEinheiten())]]></expression>
            <printWhenExpression><![CDATA[!$P{STATISTIK}.getFehlendeEinheiten().isEmpty()]]></printWhenExpression>
        </element>
    </title>

    <!-- Detail Band - One band per month -->
    <detail>
        <band height="502">
            <!-- Month header -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333330c" x="0" y="10" width="555" height="25" forecolor="#333333" fontSize="14.0" bold="true" vTextAlign="Middle">
                <expression><![CDATA[java.time.Month.of($F{monat}).getDisplayName(java.time.format.TextStyle.FULL, "de".equals($P{SPRACHE}) ? java.util.Locale.GERMAN : java.util.Locale.ENGLISH) + " " + $F{jahr} + " (" + $F{von}.format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) + " - " + $F{bis}.format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) + ")"]]></expression>
                <box>
                    <bottomPen lineWidth="2.0" lineColor="#4CAF50"/>
                </box>
            </element>

            <!-- Datenstatus -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333330d" x="0" y="40" width="120" height="15" fontSize="9.0" bold="true">
                <expression><![CDATA[$P{TRANSLATIONS}.get("DATENSTATUS") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333330e" x="120" y="40" width="200" height="15" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("DATEN_VOLLSTAENDIG")]]></expression>
                <printWhenExpression><![CDATA[$F{datenVollstaendig}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333330f" x="120" y="40" width="200" height="15" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("DATEN_UNVOLLSTAENDIG")]]></expression>
                <printWhenExpression><![CDATA[!$F{datenVollstaendig}]]></printWhenExpression>
            </element>

            <!-- Werte section header -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333310" x="0" y="60" width="200" height="18" forecolor="#666666" fontSize="12.0" bold="true">
                <expression><![CDATA[$P{TRANSLATIONS}.get("WERT")]]></expression>
            </element>

            <!-- Sums table header -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333311" mode="Opaque" x="0" y="78" width="170" height="18" backcolor="#F5F5F5" fontSize="9.0" bold="true" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("BESCHREIBUNG")]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="staticText" uuid="33333333-3333-3333-3333-333333333312" mode="Opaque" x="170" y="78" width="100" height="18" backcolor="#F5F5F5" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
                <text><![CDATA[kWh]]></text>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>

            <!-- Row: Produktion Total -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333313" x="0" y="96" width="170" height="16" fontSize="9.0" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("PRODUKTION_TOTAL")]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333314" x="170" y="96" width="100" height="16" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{summeProducerTotal})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: Produktion Total (#4CAF50 Green) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333341" x="280" y="97" width="275" height="14" scaleImage="FillFrame">
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{summeProducerTotal}, $V{maxSumme}, 275, 14, new java.awt.Color(76, 175, 80))]]></expression>
            </element>

            <!-- Row: Verbrauch Total -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333315" x="0" y="112" width="170" height="16" fontSize="9.0" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("VERBRAUCH_TOTAL")]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333316" x="170" y="112" width="100" height="16" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{summeConsumerTotal})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: Verbrauch Total (#2196F3 Blue) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333342" x="280" y="113" width="275" height="14" scaleImage="FillFrame">
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{summeConsumerTotal}, $V{maxSumme}, 275, 14, new java.awt.Color(33, 150, 243))]]></expression>
            </element>

            <!-- Row: ZEV Producer (A) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333317" x="0" y="128" width="170" height="16" fontSize="9.0" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("ZEV_PRODUCER") + " (A)"]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333318" x="170" y="128" width="100" height="16" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{summeProducerZev})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: ZEV Producer A (#FF9800 Orange) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333343" x="280" y="129" width="275" height="14" scaleImage="FillFrame">
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{summeProducerZev}, $V{maxSumme}, 275, 14, new java.awt.Color(255, 152, 0))]]></expression>
            </element>

            <!-- Row: ZEV Consumer (B) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333319" x="0" y="144" width="170" height="16" fontSize="9.0" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("ZEV_CONSUMER") + " (B)"]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331a" x="170" y="144" width="100" height="16" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{summeConsumerZev})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: ZEV Consumer B (#9C27B0 Purple) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333344" x="280" y="145" width="275" height="14" scaleImage="FillFrame">
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{summeConsumerZev}, $V{maxSumme}, 275, 14, new java.awt.Color(156, 39, 176))]]></expression>
            </element>

            <!-- Row: ZEV Consumer Berechnet (C) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331b" x="0" y="160" width="170" height="16" fontSize="9.0" vTextAlign="Middle">
                <expression><![CDATA[$P{TRANSLATIONS}.get("ZEV_CONSUMER_BERECHNET") + " (C)"]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331c" x="170" y="160" width="100" height="16" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{summeConsumerZevCalculated})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: ZEV Consumer Berechnet C (#00BCD4 Cyan) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333345" x="280" y="161" width="275" height="14" scaleImage="FillFrame">
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{summeConsumerZevCalculated}, $V{maxSumme}, 275, 14, new java.awt.Color(0, 188, 212))]]></expression>
            </element>

            <!-- Die berechneten Werte "Bezug von VNB"/"Rücklieferung" werden nicht mehr als Zeilen
                 angezeigt, sondern nur noch im Summen-Vergleich verwendet (FR-5.7). -->
            <!-- Row: Bilanz-Einheit Rücklieferung (nur falls Einheit vorhanden; Beschriftung = Einheiten-Name) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333354" x="0" y="176" width="170" height="16" removeLineWhenBlank="true" fontSize="9.0" vTextAlign="Middle">
                <printWhenExpression><![CDATA[$F{bilanzRuecklieferungName} != null]]></printWhenExpression>
                <expression><![CDATA[$F{bilanzRuecklieferungName}]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333355" x="170" y="176" width="100" height="16" removeLineWhenBlank="true" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <printWhenExpression><![CDATA[$F{bilanzRuecklieferungName} != null]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{bilanzRuecklieferung})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: Bilanz Rücklieferung (#CDDC39 Lime) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333356" x="280" y="177" width="275" height="14" removeLineWhenBlank="true" scaleImage="FillFrame">
                <printWhenExpression><![CDATA[$F{bilanzRuecklieferungName} != null]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{bilanzRuecklieferung}, $V{maxSumme}, 275, 14, new java.awt.Color(205, 220, 57))]]></expression>
            </element>

            <!-- Row: Bilanz-Einheit Bezug (nur falls Einheit vorhanden; Beschriftung = Einheiten-Name) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333351" x="0" y="192" width="170" height="16" removeLineWhenBlank="true" fontSize="9.0" vTextAlign="Middle">
                <printWhenExpression><![CDATA[$F{bilanzBezugName} != null]]></printWhenExpression>
                <expression><![CDATA[$F{bilanzBezugName}]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333352" x="170" y="192" width="100" height="16" removeLineWhenBlank="true" blankWhenNull="true" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
                <printWhenExpression><![CDATA[$F{bilanzBezugName} != null]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.kwh($F{bilanzBezug})]]></expression>
                <box leftPadding="4" rightPadding="4">
                    <pen lineWidth="0.5" lineColor="#DDDDDD"/>
                </box>
            </element>
            <!-- Bar: Bilanz Bezug (#E91E63 Pink) -->
            <element kind="image" uuid="33333333-3333-3333-3333-333333333353" x="280" y="193" width="275" height="14" removeLineWhenBlank="true" scaleImage="FillFrame">
                <printWhenExpression><![CDATA[$F{bilanzBezugName} != null]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.BarImageHelper.createBar($F{bilanzBezug}, $V{maxSumme}, 275, 14, new java.awt.Color(233, 30, 99))]]></expression>
            </element>

            <!-- Summen Vergleich section (nur Producer-Messung-Modus; im Bilanzmodus durch die Kennzahlen ersetzt) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331d" x="0" y="217" width="200" height="18" forecolor="#666666" fontSize="12.0" bold="true">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("SUMMEN_VERGLEICH")]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331e" x="200" y="217" width="355" height="15" forecolor="#999999" fontSize="8.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("TOLERANZ") + ": " + ch.nacht.util.PdfNumberFormat.kwh($P{STATISTIK}.getToleranz()) + " kWh"]]></expression>
            </element>

            <!-- Comparison: A = B -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333331f" x="0" y="234" width="50" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ}]]></printWhenExpression>
                <expression><![CDATA["A = B:"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333320" x="50" y="234" width="150" height="15" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA["✓ " + $P{TRANSLATIONS}.get("GLEICH")]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{summenCDGleich}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333321" x="50" y="234" width="150" height="15" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA["✗ " + $P{TRANSLATIONS}.get("UNGLEICH") + " (" + ch.nacht.util.PdfNumberFormat.kwhSigned($F{differenzCD}) + " kWh)"]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && !$F{summenCDGleich}]]></printWhenExpression>
            </element>

            <!-- Comparison: A = C -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333322" x="200" y="234" width="50" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ}]]></printWhenExpression>
                <expression><![CDATA["A = C:"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333323" x="250" y="234" width="150" height="15" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA["✓ " + $P{TRANSLATIONS}.get("GLEICH")]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{summenCEGleich}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333324" x="250" y="234" width="150" height="15" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA["✗ " + $P{TRANSLATIONS}.get("UNGLEICH") + " (" + ch.nacht.util.PdfNumberFormat.kwhSigned($F{differenzCE}) + " kWh)"]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && !$F{summenCEGleich}]]></printWhenExpression>
            </element>

            <!-- Comparison: B = C -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333325" x="400" y="234" width="50" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ}]]></printWhenExpression>
                <expression><![CDATA["B = C:"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333326" x="450" y="234" width="105" height="15" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA["✓ " + $P{TRANSLATIONS}.get("GLEICH")]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{summenDEGleich}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333327" x="450" y="234" width="105" height="15" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA["✗ " + $P{TRANSLATIONS}.get("UNGLEICH") + " (" + ch.nacht.util.PdfNumberFormat.kwhSigned($F{differenzDE}) + " kWh)"]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && !$F{summenDEGleich}]]></printWhenExpression>
            </element>

            <!-- Comparison: Rücklieferung (berechnet) vs. Bilanzmesspunkt RUECKLIEFERUNG (nur Producer-Modus + Einheit vorhanden) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333334" x="0" y="252" width="150" height="15" removeLineWhenBlank="true" fontSize="9.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzRuecklieferungName} != null]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("VERGLEICH_RUECKLIEFERUNG") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333335" x="150" y="252" width="125" height="15" removeLineWhenBlank="true" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA["✓ " + $P{TRANSLATIONS}.get("GLEICH")]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzRuecklieferungName} != null && $F{ruecklieferungBilanzGleich}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333336" x="150" y="252" width="125" height="15" removeLineWhenBlank="true" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA["✗ " + $P{TRANSLATIONS}.get("UNGLEICH") + " (" + ch.nacht.util.PdfNumberFormat.kwhSigned($F{ruecklieferungBilanzDifferenz}) + " kWh)"]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzRuecklieferungName} != null && !$F{ruecklieferungBilanzGleich}]]></printWhenExpression>
            </element>

            <!-- Comparison: Bezug von VNB (berechnet) vs. Bilanzmesspunkt BEZUG (nur Producer-Modus + Einheit vorhanden) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333331" x="280" y="252" width="130" height="15" removeLineWhenBlank="true" fontSize="9.0">
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzBezugName} != null]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("VERGLEICH_BEZUG") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333332" x="410" y="252" width="145" height="15" removeLineWhenBlank="true" forecolor="#4CAF50" fontSize="9.0">
                <expression><![CDATA["✓ " + $P{TRANSLATIONS}.get("GLEICH")]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzBezugName} != null && $F{bezugBilanzGleich}]]></printWhenExpression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333333" x="410" y="252" width="145" height="15" removeLineWhenBlank="true" forecolor="#F44336" fontSize="9.0">
                <expression><![CDATA["✗ " + $P{TRANSLATIONS}.get("UNGLEICH") + " (" + ch.nacht.util.PdfNumberFormat.kwhSigned($F{bezugBilanzDifferenz}) + " kWh)"]]></expression>
                <printWhenExpression><![CDATA[!$P{IST_BILANZ} && $F{bilanzBezugName} != null && !$F{bezugBilanzGleich}]]></printWhenExpression>
            </element>

            <!-- Kennzahlen section (in beiden Verteilmodi) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333360" x="0" y="275" width="555" height="18" forecolor="#666666" fontSize="12.0" bold="true">
                <expression><![CDATA[$P{TRANSLATIONS}.get("STATISTIK_KENNZAHLEN")]]></expression>
                <box>
                    <bottomPen lineWidth="1.0" lineColor="#DDDDDD"/>
                </box>
            </element>

            <!-- Quoten-KPIs (linke Spalte) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333361" x="0" y="296" width="200" height="15" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_AUTARKIEGRAD") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333362" x="200" y="296" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{autarkiegrad})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333363" x="0" y="312" width="200" height="15" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_EIGENVERBRAUCHSQUOTE") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333364" x="200" y="312" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{eigenverbrauchsquote})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333365" x="0" y="328" width="200" height="15" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_NETZBEZUGSQUOTE") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333366" x="200" y="328" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{netzbezugsquote})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333367" x="0" y="344" width="200" height="15" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_EINSPEISEQUOTE") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333368" x="200" y="344" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{einspeisequote})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333369" x="0" y="360" width="200" height="15" fontSize="9.0">
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_ZEV_EIGENVERBRAUCH") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336a" x="200" y="360" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <expression><![CDATA[$F{zevEigenverbrauch} != null ? ch.nacht.util.PdfNumberFormat.kwh($F{zevEigenverbrauch}) + " kWh" : "–"]]></expression>
            </element>

            <!-- Gemessene Gegenstücke (linke Spalte; nur mit BEZUG-Bilanz-Einheit) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333380" x="0" y="376" width="200" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{bilanzKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_AUTARKIEGRAD_GEMESSEN") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333381" x="200" y="376" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{bilanzKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{autarkiegradGemessen})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333382" x="0" y="392" width="200" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{bilanzKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_NETZBEZUGSQUOTE_GEMESSEN") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333383" x="200" y="392" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{bilanzKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{netzbezugsquoteGemessen})]]></expression>
            </element>
            <!-- Lücken im gemessenen Netzbezug: ohne diesen Hinweis wirken die beiden Werte
                 belastbarer, als sie sind. -->
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333384" x="0" y="408" width="290" height="20" forecolor="#999999" fontSize="7.0" italic="true">
                <printWhenExpression><![CDATA[$F{bilanzKennzahlenVerfuegbar} && $F{bilanzBezugLueckenhaft}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_LUECKENHAFT") + ": " + $P{TRANSLATIONS}.get($F{verteilungLueckenhaft} ? "KENNZAHL_LUECKE_VERTEILUNG_HINWEIS" : "KENNZAHL_LUECKE_MESSUNG_HINWEIS")]]></expression>
            </element>

            <!-- Batterie-KPIs (rechte Spalte; nur wenn Producer + Bilanz-Bezug + Rücklieferung vorhanden) -->
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336b" x="300" y="296" width="180" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_BATTERIE_NETTO") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336c" x="480" y="296" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$F{batterieNetto} != null ? ch.nacht.util.PdfNumberFormat.kwhSigned($F{batterieNetto}) + " kWh" : "–"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336d" x="300" y="312" width="180" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_BATTERIE_GELADEN") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336e" x="480" y="312" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$F{batterieGeladen} != null ? ch.nacht.util.PdfNumberFormat.kwh($F{batterieGeladen}) + " kWh" : "–"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-33333333336f" x="300" y="328" width="180" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_BATTERIE_ENTLADEN") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333370" x="480" y="328" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$F{batterieEntladen} != null ? ch.nacht.util.PdfNumberFormat.kwh($F{batterieEntladen}) + " kWh" : "–"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333371" x="300" y="344" width="180" height="15" fontSize="9.0">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_BATTERIE_WIRKUNGSGRAD") + ":"]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333372" x="480" y="344" width="75" height="15" fontSize="9.0" bold="true" hTextAlign="Right">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[ch.nacht.util.PdfNumberFormat.percent($F{batterieWirkungsgrad})]]></expression>
            </element>
            <element kind="textField" uuid="33333333-3333-3333-3333-333333333373" x="300" y="360" width="255" height="24" forecolor="#999999" fontSize="7.0" italic="true">
                <printWhenExpression><![CDATA[$F{batterieKennzahlenVerfuegbar}]]></printWhenExpression>
                <expression><![CDATA[$P{TRANSLATIONS}.get("KENNZAHL_BERECHNET_HINWEIS")]]></expression>
            </element>

            <!-- Subreport: Summen pro Einheit -->
            <element kind="subreport" uuid="33333333-3333-3333-3333-333333333330" x="0" y="432" width="555" height="50">
                <printWhenExpression><![CDATA[$F{einheitSummen} != null && !$F{einheitSummen}.isEmpty()]]></printWhenExpression>
                <parameter name="TRANSLATIONS">
                    <expression><![CDATA[$P{TRANSLATIONS}]]></expression>
                </parameter>
                <parameter name="SPRACHE">
                    <expression><![CDATA[$P{SPRACHE}]]></expression>
                </parameter>
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{einheitSummen})]]></dataSourceExpression>
                <expression><![CDATA[$P{EINHEIT_SUMMEN_SUBREPORT}]]></expression>
            </element>
        </band>
    </detail>

