# ZEV Environment Variables
# Vorlage fuer den MQTT-Stack (docker-compose-mqtt.yml).
# Kopieren und Werte anpassen:  cp .env.mqtt.example .env.mqtt
# Die .env.mqtt gehoert NICHT ins Repository (siehe .gitignore).
#
# Struktur dieser Datei:
#   1. Zugangsdaten und Schluessel (oben)   - in jeder Umgebung zu setzen
#   2. HTTPS-Block (Mitte)                  - der Standardbetrieb, siehe dort
#   3. MQTT/Mosquitto (unten)               - nur im MQTT-Stack
#
# WICHTIG beim ersten Aufsetzen: Der Stack laeuft ueber HTTPS mit einem Zertifikat aus
# Caddys interner CA. Ohne den einmaligen Import des Root-Zertifikats weist der Browser
# die Anwendung ab. Anleitung: Specs/HTTPS.md, Abschnitt 5.

# Anthropic API Key for AI-based unit matching
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana Admin
# Hinweis: docker-compose-mqtt.yml enthaelt KEINEN Grafana-Service ("OHNE
# Prometheus/Grafana", Zeile 1). Die beiden Werte sind hier wirkungslos und nur
# der Gleichform mit .env wegen aufgefuehrt.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Basic Auth fuer die Actuator-Endpoints (/actuator/**) von backend-/admin-/frontend-service.
# Der Spring Boot Admin Server nutzt diese Credentials, um Details (Environment, Logger, ...)
# der registrierten Services abzurufen. Defaults nur fuer lokale Entwicklung – auf NAS/Prod aendern!
ACTUATOR_USER=actuator
ACTUATOR_PASSWORD=actuator

# Basic Auth fuer die Spring-Boot-Admin-UI (http://localhost:8081) und die
# Client-Registrierung (POST /instances). Defaults nur fuer lokale Entwicklung!
SBA_USER=sba
SBA_PASSWORD=sba

# ---------------------------------------------------------------------------
# HTTPS (Zertifikatsweg A: Caddys interne CA) - siehe Specs/HTTPS.md
#
# Das ist der Standardbetrieb: https://localhost:8443, http://localhost:8000 leitet dorthin
# weiter. Die Werte gehoeren zusammen - eine halbe Umstellung ergibt 401 auf jeden API-Call
# (Issuer-Mismatch), weil der Token-iss dann nicht mehr zu BACKEND_JWT_ISSUER_URI passt.
#
# Einmalig beim Aufsetzen:
#   1. Root-Zertifikat importieren (Specs/HTTPS.md, Abschnitt 5) - sonst weist der Browser ab
#   2. Bei einem NEUEN Realm: importieren - redirectUris/webOrigins entstehen dabei aus
#      ZEV_FRONTEND_URL. Bei einem BESTEHENDEN Realm wirkt die Variable nicht mehr;
#      dann die Adressen beim Client zev-frontend in der Admin-Konsole ergaenzen
#      (Valid redirect URIs, Web origins) - und zwar VOR der Umstellung, solange der
#      alte Zugriffsweg noch laeuft.
#
# Zurueck auf HTTP: alle Zeilen dieses Blocks auskommentieren. Dann greifen die Defaults aus
# docker-compose.yml (http://localhost:8000) und der HTTP-Caddyfile.
# ---------------------------------------------------------------------------
CADDY_CONFIG=./caddy/Caddyfile.https

# Keycloak
# KC_HOSTNAME MUSS auf /auth enden. Ohne diesen Pfad schreibt Keycloak seine URLs ohne
# ihn aus (Issuer https://localhost:8443/realms/zev), und dorthin routet Caddy nicht ->
# 404 beim Login. Der relative Pfad aus KC_HTTP_RELATIVE_PATH wird NICHT zusaetzlich angehaengt.
KC_HOSTNAME=https://localhost:8443/auth
ZEV_FRONTEND_URL=https://localhost:8443
FRONTEND_KEYCLOAK_URL=https://localhost:8443/auth
FRONTEND_KEYCLOAK_REALM=zev
FRONTEND_KEYCLOAK_CLIENT_ID=zev-frontend
# Leer lassen: Das Frontend baut dann relative /api-Aufrufe auf derselben Origin.
# Compose liest die Variable OHNE Default (${VAR:-…} wuerde auch bei leerem Wert den
# Default setzen) - fehlt sie ganz, warnt jeder Start.
FRONTEND_API_BASE_URL=
BACKEND_JWT_ISSUER_URI=https://localhost:8443/auth/realms/zev
# Hinweis: E2E_BASE_URL wird von playwright.config.ts aus process.env gelesen, NICHT aus
# dieser Datei (die wertet nur Docker Compose aus). Fuer die E2E-Tests in der Shell setzen:
#   E2E_BASE_URL=https://localhost:8443 npx playwright test
E2E_BASE_URL=https://localhost:8443

# Seit server.forward-headers-strategy=framework (application.yml) NICHT mehr noetig:
# Spring erkennt den Aufruf hinter dem Proxy als same-origin und prueft CORS gar nicht erst.
# Die Zeile bleibt als Rueckfalloption stehen - falls doch "Invalid CORS request" (403)
# auftritt, hier die Origin eintragen. Betroffen waeren nur NICHT-GET-Aufrufe (POST
# /api/datenbank/abfrage, POST /api/rechnungen/generate); bei gleicher Herkunft sendet der
# Browser sonst gar keinen Origin-Header.
# http://localhost:4200 bleibt unabhaengig davon noetig: Der Angular-Dev-Server laeuft auf
# einem anderen Port und ist damit echt cross-origin.
#APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:8443
#
# NICHT umstellen: SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI zeigt auf
# http://keycloak:9000/... - diese Verbindung laeuft im Container-Netz und kennt kein TLS.
# FRONTEND_API_BASE_URL bleibt leer: Das Frontend baut relative /api-Aufrufe.

# MQTT-Broker (nur bei aktivem Spring-Profil 'mqtt', SPRING_PROFILES_ACTIVE=mqtt).
# Im Docker-Stack (docker-compose-mqtt.yml) wird MQTT_BROKER_URL fest auf tcp://mosquitto:1883
# gesetzt. Der Broker erzwingt Auth; die folgenden Credentials müssen einem Eintrag in
# MOSQUITTO_USERS entsprechen.
# Für einen externen Broker (z.B. NAS) MQTT_BROKER_URL setzen und eigene Credentials eintragen:
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_BROKER_USERNAME=zev-backend
MQTT_BROKER_PASSWORD=zev-mqtt-dev
# Optionale Feineinstellungen (Defaults in backend-service/.../application-mqtt.yml):
#MQTT_CLIENT_ID=zev-backend-subscriber
#MQTT_TOPIC=zev/+/+/messwert
#MQTT_QOS=1

# Mosquitto-Broker mit gebackener Config, aber OHNE eingebackene passwd:
# Die Zugangsdaten werden beim Container-Start aus der Umgebung (MOSQUITTO_USERS)
# generiert -> keine Secrets im Image oder im Repo.
# Einschraenkung: Passwoerter duerfen keinen Whitespace enthalten (Wort-Splitting).
# Ein Doppelpunkt im Passwort ist erlaubt (nur der erste trennt user/passwort).
MOSQUITTO_USERS=zev-backend:zev-mqtt-dev
