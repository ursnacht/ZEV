# ZEV Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key for AI-based unit matching
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana Admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Basic Auth fuer die Actuator-Endpoints (/actuator/**) von backend-/admin-/frontend-service.
# Der Spring Boot Admin Server nutzt diese Credentials, um Details (Environment, Logger, ...)
# der registrierten Services abzurufen. Defaults nur fuer lokale Entwicklung – auf NAS/Prod aendern!
ACTUATOR_USER=actuator
ACTUATOR_PASSWORD=actuator

# Basic Auth fuer die Spring-Boot-Admin-UI (http://localhost:8081) und die
# Client-Registrierung (POST /instances). Defaults nur fuer lokale Entwicklung!
SBA_USER=sba
SBA_PASSWORD=sba

# NVD API Key fuer OWASP Dependency-Check (scripts/owasp-dependency-check.ps1)
# Kostenlos anfordern: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---------------------------------------------------------------------------
# HTTPS lokal (Zertifikatsweg A: Caddys interne CA) - siehe Specs/HTTPS.md
#
# Ohne diesen Block laeuft der Stack wie bisher auf http://localhost:8000.
# Zum Umstellen ALLE sechs Zeilen einkommentieren und den Stack neu starten -
# eine halbe Umstellung ergibt 401 auf jeden API-Call (Issuer-Mismatch).
# Danach einmalig das Root-Zertifikat importieren (Anleitung in Specs/HTTPS.md)
# und den Realm neu importieren (redirectUris/webOrigins haengen an ZEV_FRONTEND_URL).
# ---------------------------------------------------------------------------
#CADDY_CONFIG=./caddy/Caddyfile.https
# KC_HOSTNAME MUSS auf /auth enden. Ohne diesen Pfad schreibt Keycloak seine URLs ohne
# ihn aus (Issuer https://localhost:8443/realms/zev), und dorthin routet Caddy nicht ->
# 404 beim Login. Der relative Pfad aus KC_HTTP_RELATIVE_PATH wird NICHT zusaetzlich angehaengt.
#KC_HOSTNAME=https://localhost:8443/auth
#ZEV_FRONTEND_URL=https://localhost:8443
#FRONTEND_KEYCLOAK_URL=https://localhost:8443/auth
#BACKEND_JWT_ISSUER_URI=https://localhost:8443/auth/realms/zev
#E2E_BASE_URL=https://localhost:8443
# Seit server.forward-headers-strategy=framework (application.yml) NICHT mehr noetig:
# Spring erkennt den Aufruf hinter dem Proxy als same-origin und prueft CORS gar nicht erst.
# Die Zeile bleibt als Rueckfalloption stehen - falls doch "Invalid CORS request" (403)
# auftritt, hier die Origin eintragen. Betroffen waeren nur NICHT-GET-Aufrufe (POST
# /api/datenbank/abfrage, POST /api/rechnungen/generate); bei gleicher Herkunft sendet der
# Browser sonst gar keinen Origin-Header.
# http://localhost:4200 bleibt unabhaengig davon noetig: Der Angular-Dev-Server laeuft auf
# einem anderen Port und ist damit echt cross-origin.
#APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:8443
#
# NICHT umstellen: SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI zeigt auf
# http://keycloak:9000/... - diese Verbindung laeuft im Container-Netz und kennt kein TLS.
# FRONTEND_API_BASE_URL bleibt leer: Das Frontend baut relative /api-Aufrufe.
