<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>ch.nacht</groupId>
  <artifactId>zev-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ZEV Parent</name>

  <modules>
    <module>admin-service</module>
    <module>backend-service</module>
    <module>design-system</module>
    <module>frontend-service</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- ACHTUNG: An die Spring-Boot-Minor-Version gekoppelt (SBA 4.x.y <-> Spring Boot 4.x).
         Nie einzeln anheben, immer zusammen mit dem Parent oben:
         SBA 4.1.2 auf Spring Boot 4.0.7 bricht beim Start des admin-service mit
         NoClassDefFoundError org.springframework.boot.http.client.InetAddressFilter
         (Klasse existiert erst ab Spring Boot 4.1) - verifiziert 2026-08-13. -->
    <spring-boot-admin.version>4.1.2</spring-boot-admin.version>
    <!-- Sicherheits-Override der Spring-Boot-verwalteten Versionen (CVE-Fixes).
         Entfernen, sobald ein Spring-Boot-Parent-Update diese Versionen mitbringt.
         Die frueheren Overrides fuer tomcat (11.0.22) und netty (4.2.15.Final) sind mit
         Spring Boot 4.1.0 entfallen - das BOM pinnt exakt dieselben Versionen. -->
    <!-- postgresql: Spring Boot 4.1.0 pinnt 42.7.11, das ist ZU ALT.
         42.7.12 behebt CVE-2026-42198 (HIGH, client-seitiger DoS im pgjdbc-Treiber),
         42.7.13 = aktueller Patch. Override muss bleiben, sonst Downgrade auf eine
         verwundbare Version. -->
    <postgresql.version>42.7.13</postgresql.version>
  </properties>
</project>
