<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>ch.nacht</groupId>
  <artifactId>zev-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ZEV Parent</name>

  <modules>
    <module>admin-service</module>
    <module>backend-service</module>
    <module>design-system</module>
    <module>frontend-service</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- ACHTUNG: An die Spring-Boot-Minor-Version gekoppelt (SBA 4.x.y <-> Spring Boot 4.x).
         Nie einzeln anheben, immer zusammen mit dem Parent oben:
         SBA 4.1.2 auf Spring Boot 4.0.7 bricht beim Start des admin-service mit
         NoClassDefFoundError org.springframework.boot.http.client.InetAddressFilter
         (Klasse existiert erst ab Spring Boot 4.1) - verifiziert 2026-08-13. -->
    <spring-boot-admin.version>4.1.2</spring-boot-admin.version>
    <!-- Sicherheits-Overrides der Spring-Boot-verwalteten Versionen (CVE-Fixes).
         Jeweils entfernen, sobald ein Spring-Boot-Parent-Update die Version mitbringt ODER
         ueberschreitet - vorher pruefen (OWASP-Lauf), ob das BOM nicht nach UNTEN zieht.
         Spring Boot 4.1.0 pinnt: tomcat 11.0.22, netty 4.2.15.Final, postgresql 42.7.11. -->
    <!-- tomcat 11.0.22 -> 11.0.24 behebt (CRITICAL):
         CVE-2026-53434, CVE-2026-55276, CVE-2026-59083, CVE-2026-59084
         sowie CVE-2026-66299, CVE-2026-53404, CVE-2026-55955, CVE-2026-55956, CVE-2026-50229 -->
    <tomcat.version>11.0.24</tomcat.version>
    <!-- netty 4.2.15.Final -> 4.2.17.Final behebt (CRITICAL):
         CVE-2026-56820, CVE-2026-56817 sowie CVE-2026-55851, CVE-2026-56745, CVE-2026-59901,
         CVE-2026-44891, CVE-2026-55831, CVE-2026-55833, CVE-2026-56816, CVE-2026-56819,
         CVE-2026-56821, CVE-2026-56822, CVE-2026-59898, CVE-2026-59899, CVE-2026-59900,
         CVE-2026-56746, CVE-2026-59919, CVE-2026-59920, CVE-2026-59921 -->
    <netty.version>4.2.17.Final</netty.version>
    <!-- postgresql: Spring Boot 4.1.0 pinnt 42.7.11, das ist ZU ALT.
         42.7.12 behebt CVE-2026-42198 (HIGH, client-seitiger DoS im pgjdbc-Treiber),
         42.7.13 = aktueller Patch. Override muss bleiben, sonst Downgrade auf eine
         verwundbare Version. -->
    <postgresql.version>42.7.13</postgresql.version>
  </properties>
</project>
