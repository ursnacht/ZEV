<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>ch.nacht</groupId>
  <artifactId>zev-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ZEV Parent</name>

  <modules>
    <module>admin-service</module>
    <module>backend-service</module>
    <module>design-system</module>
    <module>frontend-service</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- ACHTUNG: An die Spring-Boot-Minor-Version gekoppelt (SBA 4.x.y <-> Spring Boot 4.x).
         Nie einzeln anheben, immer zusammen mit dem Parent oben:
         SBA 4.1.2 auf Spring Boot 4.0.7 bricht beim Start des admin-service mit
         NoClassDefFoundError org.springframework.boot.http.client.InetAddressFilter
         (Klasse existiert erst ab Spring Boot 4.1) - verifiziert 2026-08-13. -->
    <spring-boot-admin.version>4.1.4</spring-boot-admin.version>
    <!-- Sicherheits-Overrides der Spring-Boot-verwalteten Versionen (CVE-Fixes) gehoeren hierher,
         z.B. <tomcat.version>. Jeweils entfernen, sobald ein Spring-Boot-Parent-Update die Version
         mitbringt ODER ueberschreitet - vorher pruefen (OWASP-Lauf), ob das BOM nicht nach UNTEN
         zieht. Derzeit keine: Spring Boot 4.1.2 bringt tomcat 11.0.27, netty 4.2.19.Final und
         postgresql 42.7.14 mit und schliesst damit alles, wofuer bis 4.1.0 Overrides noetig
         waren (verifiziert per OWASP-Lauf und Advisories am 2026-10-26). -->
  </properties>
</project>
